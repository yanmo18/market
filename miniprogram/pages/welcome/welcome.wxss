/* pages/welcome/welcome.wxss */
.swiper-container {
  height: 500rpx;
}
.swiper-img {
  width: 100%;
}
.middle-container{

  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 20rpx;
  padding: 20rpx;
}
.middle-container .wrapper{
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.middle-container image{
  height: 100rpx;
  width: 100%;
  border-radius: 50%;
}
.wrapper .comment{
  font-size: 20rpx;
}
.foot-container{
  /* border:2rpx solid #000; */
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40rpx;
  padding: 40rpx;
}
.foot-container image{
  border-radius: 10%;
  width: 280rpx;
  height: 230rpx;
}
.foot-container .foot-card{
  /* border:3rpx solid #000; */
  padding: 20rpx;
}
.foot-card .card-text-foot{
  width: 280rpx;
  /* border: solid 2rpx green; */
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;

}
.card-price{
  font-size: 24rpx;
  font-weight: 400;
  color:red
}
.card-madein{
  font-size: 24rpx;
  font-weight: 400;

}